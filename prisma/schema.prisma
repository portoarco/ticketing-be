generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id                 String                @id @default(uuid())
  first_name         String
  last_name          String
  email              String                @unique
  password           String
  country            String
  birthdate          DateTime
  phone_number       String
  avatar             String?
  isVerified         Boolean               @default(false)
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt
  referrer_code      String?
  refferal_code      String?               @unique
  attendees_user     Event_Attendees[]
  reviews_user       Event_Reviews[]
  organizer          Organizer?
  referral_user      Referral_Code[]
  usageReferral_user Referral_Usage[]
  transactions       Transactions_detail[]
  user_voucher       Voucher[]
}

model Organizer {
  id                           String                @id @default(uuid())
  user_id                      String                @unique
  organizer_name               String                @default("No Organizer")
  organizer_articles           Articles[]
  event                        Events[]
  user                         Users                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organizer_transactionDetails Transactions_detail[]
  organizer_voucher            Voucher[]
}

model Articles {
  id           String    @id @default(uuid())
  organizer_id String
  title        String
  created_at   DateTime  @default(now())
  organizer    Organizer @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
}

model Events {
  id                      String                @id @default(uuid())
  organizer_id            String
  event_category_id       String
  event_location_id       String
  name                    String
  description             String
  start_date              DateTime
  end_date                DateTime?
  image                   String?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  price                   Int?
  attendees_event         Event_Attendees[]
  reviews_event           Event_Reviews[]
  category_event          Event_Category        @relation(fields: [event_category_id], references: [id], onDelete: Cascade)
  location_Event          Event_Location        @relation(fields: [event_location_id], references: [id], onDelete: Cascade)
  organizer               Organizer             @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  TicketType              TicketType[]
  event_transactionDetail Transactions_detail[]
}

model Event_Category {
  id    String   @id @default(uuid())
  name  String   @unique
  event Events[]
}

model Event_Location {
  id       String   @id @default(uuid())
  event_id String
  city     String
  address  String
  event    Events[]
}

model Event_Reviews {
  id            String   @id @default(uuid())
  user_id       String
  events_id     String
  review        String?
  rating        Int?
  created_at    DateTime @default(now())
  reviews_event Events   @relation(fields: [events_id], references: [id], onDelete: Cascade)
  reviews_user  Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Event_Attendees {
  id             String @id @default(uuid())
  user_id        String
  event_id       String
  status         Status
  user_event     Events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_attendees Users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Referral_Code {
  id                 String           @id @default(uuid())
  user_id            String
  code               String
  points             Int?             @default(0)
  created_at         DateTime         @default(now())
  expired_at         DateTime?
  user_referral      Users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_referralUsage Referral_Usage[]
}

model Referral_Usage {
  id                 String        @id @default(uuid())
  user_id            String
  referral_code_id   String
  used_at            DateTime      @default(now())
  code_referralUsage Referral_Code @relation(fields: [referral_code_id], references: [id], onDelete: Cascade)
  user_referralUsage Users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Voucher {
  id                          String                @id @default(uuid())
  user_id                     String?
  organizer_id                String?
  code                        String
  amount                      Int?
  expired_at                  DateTime
  percentage                  Int?
  created_at                  DateTime              @default(now())
  voucher_transaction_details Transactions_detail[]
  voucher_organizer           Organizer?            @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  voucher_user                Users?                @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Transactions_detail {
  id                          String            @id @default(uuid())
  user_id                     String
  event_id                    String
  organizer_id                String
  quantity                    Int
  isConfirmed                 Boolean           @default(false)
  transaction_status          TransactionStatus
  amount                      Int               @default(0)
  created_at                  DateTime          @default(now())
  paid_at                     DateTime?
  proof                       String            @default("")
  updated_at                  DateTime          @updatedAt
  voucher_id                  String?
  detail_event                Events            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  detail_organizer            Organizer         @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  user                        Users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction_voucher_details Voucher?          @relation(fields: [voucher_id], references: [id], onDelete: Cascade)
}

model TicketType {
  id       String @id
  event_id String
  name     String
  price    Int
  quantity Int
  Events   Events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

enum Status {
  PENDING
  CONFIRMED
  CANCELED
}

enum TransactionStatus {
  PENDING
  PAID
  REJECTED
}
